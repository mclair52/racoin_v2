{
    "require": {
        "php": ">=8.2",
        "slim/slim": "4.*",
        "twig/twig": "3.*",
        "illuminate/database": "11.*",
        "ext-mysqli": "*",
        "ext-pdo": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "scripts": {
        "test": [
            "./vendor/bin/phpunit tests/"
        ]
    },
    "autoload": {
        "psr-4": {
            "Controller\\": "controller/",
            "Model\\": "model/",
            "Db\\": "db/"
        }
    },
    "config": {
        "allow-plugins": {
            "kylekatarnls/update-helper": true
        }
    }
}